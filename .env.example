# Copy to .env.local and fill in (Supabase dashboard → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only – never expose to the browser. Needed for inviting users.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app (used in invite / password reset links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
