# Copy to .env and fill in (Supabase dashboard → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only – never expose to the browser. Needed for inviting users.
SUPABASE_SECRET_KEY=sb_secret_...

# Links in invite / password reset emails use the "Site URL" set in the
# Supabase dashboard (Authentication → URL Configuration), not an env variable.
